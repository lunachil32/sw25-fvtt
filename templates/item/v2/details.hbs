<section>
  <h2>{{item.name}}</h2>
  <fieldset class="v2-description"><legend>{{localize "SW25.Description"}}</legend>
    <prose-mirror name="system.description" value="{{system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror>
  </fieldset>
  {{#each itemFieldGroups as |group|}}
  <fieldset><legend>{{localize group.label}}</legend>
  <div class="v2-item-fields">
    {{#each group.fields as |field|}}
    <label>{{localize field.label}}
      {{#if field.select}}
      <select name="{{field.name}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions field.options selected=field.value localize=field.localizeOptions blank="-"}}</select>
      {{else if field.textarea}}
      <textarea name="{{field.name}}" {{#unless @root.editable}}disabled{{/unless}}>{{field.value}}</textarea>
      {{else if field.checkbox}}
      <input type="checkbox" name="{{field.name}}" {{checked field.value}} data-dtype="Boolean" {{#unless @root.editable}}disabled{{/unless}}>
      {{else}}
      <input type="{{field.type}}" name="{{field.name}}" value="{{field.value}}" data-dtype="{{field.dtype}}" {{#unless @root.editable}}disabled{{/unless}}>
      {{/if}}
    </label>
    {{/each}}
  </div>
  </fieldset>
  {{/each}}
</section>

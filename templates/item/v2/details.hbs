<section>
  <h2>{{item.name}}</h2>
  <div class="v2-image-field">
    <img src="{{item.img}}" alt="{{item.name}}" width="64" height="64">
    <label>{{localize "Image"}}<file-picker name="img" type="image" value="{{item.img}}" {{#unless editable}}disabled{{/unless}}></file-picker></label>
  </div>
  {{#if isSession}}<button type="button" data-action="sessionResult" {{#unless editable}}disabled{{/unless}}>{{localize "SW25.Item.Session.OutputResult"}}</button>{{/if}}
  <fieldset class="v2-description"><legend>{{localize "SW25.Description"}}</legend>
    <prose-mirror name="system.description" value="{{system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror>
  </fieldset>
  {{#each itemFieldGroups as |group|}}
  <fieldset><legend>{{localize group.label}}</legend>
  <div class="v2-item-fields">
    {{#each group.fields as |field|}}
    <label>{{localize field.label}}
      {{#if field.select}}
      <select name="{{field.name}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions field.options selected=field.value localize=field.localizeOptions blank="-"}}</select>
      {{else if field.textarea}}
      <textarea name="{{field.name}}" {{#unless @root.editable}}disabled{{/unless}}>{{field.value}}</textarea>
      {{else if field.checkbox}}
      <input type="checkbox" name="{{field.name}}" {{checked field.value}} data-dtype="Boolean" {{#unless @root.editable}}disabled{{/unless}}>
      {{else}}
      <input type="{{field.type}}" name="{{field.name}}" value="{{field.value}}" data-dtype="{{field.dtype}}" {{#unless @root.editable}}disabled{{/unless}}>
      {{/if}}
    </label>
    {{/each}}
  </div>
  </fieldset>
  {{/each}}
  {{#if isSession}}
  <fieldset class="v2-custom-fields"><legend>{{localize "SW25.Customs"}}</legend>
    <button type="button" data-action="customField" data-operation="add" {{#unless editable}}disabled{{/unless}}>{{localize "SW25.Adding"}}</button>
    {{#each system.customFields as |field index|}}
    <div class="v2-item-fields">
      <label>{{localize "SW25.Custom.Name"}}<input name="system.customFields.{{index}}.label" value="{{field.label}}" {{#unless @root.editable}}disabled{{/unless}}></label>
      <label>{{localize "SW25.Custom.Value"}}<input name="system.customFields.{{index}}.value" value="{{field.value}}" {{#unless @root.editable}}disabled{{/unless}}></label>
      <button type="button" data-action="customField" data-operation="up" data-index="{{index}}" {{#unless @root.editable}}disabled{{/unless}}>{{localize "SW25.Custom.MoveUp"}}</button>
      <button type="button" data-action="customField" data-operation="down" data-index="{{index}}" {{#unless @root.editable}}disabled{{/unless}}>{{localize "SW25.Custom.MoveDown"}}</button>
      <button type="button" data-action="customField" data-operation="remove" data-index="{{index}}" {{#unless @root.editable}}disabled{{/unless}}>{{localize "SW25.Custom.Delete"}}</button>
    </div>
    {{/each}}
  </fieldset>
  {{/if}}
</section>

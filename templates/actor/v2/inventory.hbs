<section class="v2-inventory">
  <h2>{{localize "SW25.V2.Items"}}</h2>
  <div class="v2-item-create">
    <label>{{localize "SW25.V2.ItemType"}}<select data-item-type {{#unless editable}}disabled{{/unless}}>{{selectOptions itemTypes selected=selectedItemType localize=true}}</select></label>
    <button type="button" data-action="createItem" {{#unless editable}}disabled{{/unless}}>{{localize "SW25.V2.CreateItem"}}</button>
  </div>
  <ul>
    {{#each managedItems as |item|}}
    <li data-item-id="{{item._id}}"><span>{{item.name}}</span>
      <button type="button" data-action="useItem" {{#unless @root.editable}}disabled{{/unless}}>{{localize "SW25.Use"}}</button>
      <button type="button" data-action="editItem">{{localize "SW25.V2.EditItem"}}</button>
      <button type="button" data-action="deleteItem" {{#unless @root.editable}}disabled{{/unless}}>{{localize "SW25.V2.DeleteItem"}}</button>
    </li>
    {{/each}}
  </ul>
</section>

<section class="v2-profile">
  <h2>{{localize "SW25.V2.Profile"}}</h2>
  <div class="v2-fields">{{#each profileFields as |field|}}
      <label>{{localize field.label}}<input name="{{field.name}}" type="{{field.type}}" data-dtype="{{field.dtype}}" value="{{field.value}}" {{#unless @root.editable}}disabled{{/unless}}></label>
      {{/each}}</div>
  <h3>{{localize "SW25.V2.Vitals"}}</h3>
  <div class="v2-fields">{{#each vitalFields as |field|}}
      <label>{{localize field.label}}<input name="{{field.name}}" type="{{field.type}}" data-dtype="{{field.dtype}}" value="{{field.value}}" {{#unless @root.editable}}disabled{{/unless}}></label>
      {{/each}}</div>
  <h3>{{localize "SW25.Abilityname"}}</h3>
  <button type="button" data-action="growthCheck" {{#unless editable}}disabled{{/unless}}>{{localize "SW25.Ability.Growth"}}</button>
  <div class="v2-fields">{{#each baseFields as |field|}}
      <label>{{localize field.label}}<input name="{{field.name}}" type="{{field.type}}" data-dtype="{{field.dtype}}" value="{{field.value}}" {{#unless @root.editable}}disabled{{/unless}}></label>
      {{/each}}</div>
  <table class="v2-ability-inputs">
    <thead><tr><th>{{localize "SW25.Abilityname"}}</th><th>{{localize "SW25.V2.Base"}}</th><th>{{localize "SW25.V2.Growth"}}</th><th>{{localize "SW25.Modifier"}}</th><th>{{localize "SW25.V2.Total"}}</th></tr></thead>
    <tbody>{{#each system.abilities as |ability key|}}
      <tr><th>{{ability.label}}</th>
        <td><input aria-label="{{ability.label}} {{localize 'SW25.V2.Base'}}" type="number" name="system.abilities.{{key}}.valuebase" value="{{ability.valuebase}}" data-dtype="Number" {{#unless @root.editable}}disabled{{/unless}}></td>
        <td><input aria-label="{{ability.label}} {{localize 'SW25.V2.Growth'}}" type="number" name="system.abilities.{{key}}.valuegrowth" value="{{ability.valuegrowth}}" data-dtype="Number" {{#unless @root.editable}}disabled{{/unless}}></td>
        <td><input aria-label="{{ability.label}} {{localize 'SW25.Modifier'}}" type="number" name="system.abilities.{{key}}.valuemodify" value="{{ability.valuemodify}}" data-dtype="Number" {{#unless @root.editable}}disabled{{/unless}}></td>
        <td>{{ability.value}} ({{ability.mod}})</td>
      </tr>{{/each}}
    </tbody>
  </table>
  <fieldset class="v2-combat"><legend>{{localize "SW25.Battle"}}</legend>
    <div class="v2-fields">
      {{#each combatSelections as |field|}}
      <label>{{localize field.label}}<select name="{{field.name}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions field.options selected=field.value}}</select></label>
      {{/each}}
      {{#each combatFields as |field|}}
      <label>{{localize field.label}}<input name="{{field.name}}" type="{{field.type}}" data-dtype="{{field.dtype}}" value="{{field.value}}" {{#unless @root.editable}}disabled{{/unless}}></label>
      {{/each}}
    </div>
    <p>{{localize "SW25.Attributes.Protectionpoint.long"}}: {{system.attributes.protectionpoint}} / {{localize "SW25.Attributes.Magicprotection.long"}}: {{system.attributes.magicprotection}}</p>
  </fieldset>
  <fieldset class="v2-spell-settings"><legend>{{localize "SW25.Selectspellskill"}}</legend>
    {{#each spellFields as |field|}}
    <fieldset><legend>{{localize field.label}}</legend><div class="v2-fields">
      <label>{{localize "SW25.Selectspellskill"}}<select name="{{field.name}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions field.options selected=field.value blank="-"}}</select></label>
      <label>{{localize "SW25.Modifier"}}<input type="number" name="{{field.modifierName}}" value="{{field.modifier}}" data-dtype="Number" {{#unless @root.editable}}disabled{{/unless}}></label>
      <span>{{localize "SW25.Attributes.Magicpower"}}: {{field.power}}</span>
    </div></fieldset>
    {{/each}}
  </fieldset>
  <fieldset class="v2-fairy-contracts"><legend>{{localize "SW25.Item.Spell.Fairy"}}</legend>
    <div class="v2-fields">{{#each fairyContracts as |field|}}
      <label>{{localize field.label}}<input type="checkbox" name="{{field.name}}" data-dtype="Boolean" {{checked field.value}} {{#unless @root.editable}}disabled{{/unless}}></label>
    {{/each}}</div>
    <p>{{localize "SW25.Item.Spell.FairyContract.Rank"}}: {{system.frRank}}</p>
  </fieldset>
  <fieldset class="v2-item-skill-settings"><legend>{{localize "SW25.Defaultitemskill"}}</legend><div class="v2-fields">
    {{#each itemSkillFields as |field|}}
    <label>{{localize field.label}}<select name="{{field.name}}" {{#unless @root.editable}}disabled{{/unless}}>{{selectOptions field.options selected=field.value blank="-"}}</select></label>
    {{/each}}
  </div></fieldset>
  <fieldset class="v2-fellow-settings"><legend>{{localize "SW25.ActionTable"}}</legend>
    <div class="v2-fields">
      <label>{{localize "SW25.Item.Action.TableType"}}<select name="system.tabletype" {{#unless editable}}disabled{{/unless}}>{{selectOptions config.fellowTypes selected=system.tabletype localize=true}}</select></label>
      <label>{{localize "SW25.Attributes.Exp"}}<input type="checkbox" name="system.attributes.fellowexp" data-dtype="Boolean" {{checked system.attributes.fellowexp}} {{#unless editable}}disabled{{/unless}}></label>
      <label>{{localize "SW25.Reward"}}<input type="checkbox" name="system.attributes.fellowreward" data-dtype="Boolean" {{checked system.attributes.fellowreward}} {{#unless editable}}disabled{{/unless}}></label>
      <label>{{localize "SW25.CancelDialog"}}<input name="system.canceldialog" value="{{system.canceldialog}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    <label>{{localize "SW25.Fellowmemo"}}<textarea name="system.fellowmemo" {{#unless editable}}disabled{{/unless}}>{{system.fellowmemo}}</textarea></label>
    <table class="v2-action-table">
      <thead><tr><th>{{localize "SW25.ActionTable"}}</th><th>{{localize "SW25.Item.Action.Action"}}</th><th>{{localize "SW25.Item.Action.ActionValue"}}</th><th>{{localize "SW25.Item.Action.ActionEffect"}}</th></tr></thead>
      <tbody>{{#each actionRows as |row|}}
        {{#each row.items as |item|}}
        <tr data-item-id="{{item._id}}"><th>{{row.range}}</th><td>{{item.name}}<p>{{item.system.action}}</p>
          <button type="button" data-action="editItem">{{localize "SW25.V2.EditItem"}}</button>
          <button type="button" data-action="useItem" {{#unless @root.editable}}disabled{{/unless}}>{{localize "SW25.Use"}}</button>
        </td><td>{{item.system.actionvalue}}</td><td>{{item.system.actioneffect}}</td></tr>
        {{else}}<tr><th>{{row.range}}</th><td colspan="3">—</td></tr>{{/each}}
      {{/each}}</tbody>
    </table>
    <button type="button" data-action="rollActionTable" {{#unless editable}}disabled{{/unless}}>{{localize "SW25.ActionRoll"}} (1d6)</button>
  </fieldset>
  <fieldset class="v2-biography"><legend>{{localize "SW25.Description"}}</legend>
    <prose-mirror name="system.biography" value="{{system.biography}}" data-document-uuid="{{actor.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{biographyHTML}}}</prose-mirror>
  </fieldset>
</section>

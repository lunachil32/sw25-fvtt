<ol class='items-list'>
  {{#if noteshow}}
    <div class='item flexrow items-header'>
      <div class='item-name'>{{localize "TYPES.Item.magicalsong"}}</div>
    </div>
    <div class='item flexrow ability-resource'>
      <div class='resources'>
        <div class="ability-label">
          <div class="notesreset left-position" data-tooltip="{{localize "SW25.Reset" type=(localize "SW25.Item.Resource.Types.Note")}}" data-action="resetResources" data-resource-type="note"><i class="fa-solid fa-arrow-rotate-left"></i></div>
          {{localize "SW25.Item.Magicalsong.Music"}}
        </div>
        {{#each notes as |item id|}}
          <li class='item draggable' data-item-id='{{item._id}}'>
            <div class="item-prop flexrow flex-group-center">
              <h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
            </div>
            {{#if ../isOwner}}
              <div class='item-quantity item-prop flexrow flex-group-center' style="flex: 0 0 80px;">
                <a class="quantity-button" data-adjustment="decrease" data-property="item.system.quantity" data-action="adjustItemField" data-field="quantity">
                  <i class="fas fa-minus"></i>
                </a>
                <input class="qt-change" type="text" value="{{item.system.quantity}}" data-dtype="Number" data-item-field="quantity"/>
                <a class="quantity-button" data-adjustment="increase" data-property="item.system.quantity" data-action="adjustItemField" data-field="quantity">
                  <i class="fas fa-plus"></i>
                </a>
              </div>
              {{#if ../system.isEdit}}
              <div class='item-controls'>
                <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.resource")}}' data-action="editItem">
                  <i class='fas fa-edit'></i>
                </a>
                <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.resource")}}' data-action="deleteItem">
                  <i class='fas fa-trash'></i>
                </a>
              </div>
              {{/if}}
            {{else}}
              <div class='item-prop flexrow flex-group-center' style="flex: 0 0 80px;">
                <input class="qt-change" type="text" value="{{item.system.quantity}}" data-dtype="Number" data-item-field="quantity"/>
              </div>
            {{/if}}
          </li>
        {{/each}}
      </div>
    </div>
  {{/if}}
  <li class='item flexrow items-header'>
    <div class='item-name'>{{#if noteshow}}{{localize "SW25.Item.Name"}}{{else}}{{localize "TYPES.Item.magicalsong"}}{{/if}}</div>
    <div class='item-element' style="flex: 0 0 50px;">{{localize "SW25.Item.Magicalsong.Music"}}</div>
    <div class='item-element' style="flex: 0 0 70px;">{{localize "SW25.Adding"}}</div>
    <div class='item-element sidebar-hidden' style="flex: 0 0 40px;">{{localize "SW25.Item.Resist"}}</div>
    <div class='item-element sidebar-hidden' style="flex: 0 0 80px;">{{localize "SW25.Item.Prop"}}</div>
    <div class='item-controls'>
      <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.magicalsong")}}' data-item-type='magicalsong' data-action="createItem">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type=''}}
      </a>
    </div>
  </li>
  {{#each magicalsongs as |item id|}}
    <li class='item draggable' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action="rollFormula">
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          {{> "systems/sw25-lunachil-maintained/templates/helper/action-marks.hbs"}}
          <{{system.typename}}><h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
        </div>
        {{> "systems/sw25-lunachil-maintained/templates/actor/v2/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 50px;">
          {{#if (eq system.type "song")}}<div class="notesget" data-action="updateNotes" data-notes="get">{{#unless (eq system.upget 0)}}<i class="fa-solid fa-arrow-turn-up"></i>{{system.upget}}{{/unless}}{{#unless (eq system.downget 0)}}<i class="fa-solid fa-arrow-turn-down"></i>{{system.downget}}{{/unless}}{{#unless (eq system.charmget 0)}}<i class="fa-regular fa-heart"></i>{{system.charmget}}{{/unless}}</div>{{/if}}
          {{#if (eq system.type "final")}}<div class="notescost" data-action="updateNotes" data-notes="cost">{{#unless (eq system.upcost 0)}}<i class="fa-solid fa-arrow-turn-up"></i>{{system.upcost}}{{/unless}}{{#unless (eq system.downcost 0)}}<i class="fa-solid fa-arrow-turn-down"></i>{{system.downcost}}{{/unless}}{{#unless (eq system.charmcost 0)}}<i class="fa-regular fa-heart"></i>{{system.charmcost}}{{/unless}}</div>{{/if}}
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 70px;">
          {{#if (eq system.type "song")}}<div class="notesaddget" data-action="updateNotes" data-notes="add">{{#unless (eq system.upadd 0)}}<i class="fa-solid fa-arrow-turn-up"></i>{{system.upadd}}{{/unless}}{{#unless (eq system.downadd 0)}}<i class="fa-solid fa-arrow-turn-down"></i>{{system.downadd}}{{/unless}}{{#unless (eq system.charmadd 0)}}<i class="fa-regular fa-heart"></i>{{system.charmadd}}{{/unless}}({{system.singpoint}})</div>{{/if}}
        </div>
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 0 0 40px;">
          {{system.resistname}}
        </div>
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 0 0 80px;">
          {{system.propname}}
        </div>
        {{#if ../isOwner}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.magicalsong")}}' data-action="editItem">
              <i class='fas fa-edit'></i>
            </a>
            {{#if ../system.isEdit}}
              <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.magicalsong")}}' data-action="deleteItem">
                <i class='fas fa-trash'></i>
              </a>
            {{else}}
              <div class="item-equip">
                {{#if system.useequip}}
                <label class="equip-toggle">
                  <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
                </label>
                {{/if}}
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.View" type=(localize "TYPES.Item.magicalsong")}}' data-action="editItem">
              <i class='fa-solid fa-eye'></i>
            </a>
            <div class="item-equip">
              {{#if system.useequip}}
              <label class="equip-toggle">
                <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
              </label>
              {{/if}}
            </div>
          </div>
        {{/if}}
      </div>
      <div class="item-description nogapmargin">
        <div class="flexrow">
          <div style="flex: 0 0 60px;"></div>
          <div style="font-size: 0.8em;">
            {{{descriptionHTML}}}
          </div>
          <div style="flex: 0 0 50px;"></div>
        </div>
      </div>
    </li>
  {{/each}}
</ol>

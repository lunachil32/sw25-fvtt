<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.monsterability"}}</div>
    <div class='item-controls'>
      <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.monsterability")}}' data-item-type='monsterability' data-action="createItem">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type=''}}
      </a>
    </div>
  </li>
  {{#each monsterabilities as |item id|}}
    <li class='item draggable' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class="item-equip">
          {{#if system.useequip}}
          <label class="equip-toggle">
            <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
          </label>
          {{/if}}
        </div>
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action="rollFormula">
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          {{> "systems/sw25-lunachil-maintained/templates/helper/action-marks.hbs"}}
          <h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
        </div>
        <div class="rollable" style="flex: 0 0 auto; margin-left: 10px; display: {{#if system.usedice1}}block{{else}}none{{/if}};" data-roll="{{item.system.checkformula1}}+{{item.system.checkbase1}}" data-label="{{item.name}} ({{item.system.label1}})" data-pt="{{item.system.powertable}}" data-apply="{{system.applycheck1}}" data-checktype="{{system.checkTypesButton}}" {{resistAttributes type system.dice1.resist}} data-action="rollFormula">
          <b>{{item.system.label1}}:{{item.system.checkbase1}}({{item.system.checkbasefix1}})</b>
        </div>
          <div class='item-checkmod item-prop input' style="flex: 0 0 40px; display: {{#if system.usedice1}}block{{else}}none{{/if}};"><input class="cm1-change" type="text" value="{{item.system.checkmod1}}" data-dtype="Number" data-item-field="checkmod1"/></div>
        <div class="rollable" style="flex: 0 0 auto; margin-left: 10px; display: {{#if system.usedice2}}block{{else}}none{{/if}};" data-roll="{{item.system.checkformula2}}+{{item.system.checkbase2}}" data-label="{{item.name}} ({{item.system.label2}})" data-pt="{{item.system.powertable}}" data-apply="{{system.applycheck2}}" data-checktype="{{system.checkTypesButton}}" {{resistAttributes type system.dice2.resist}} data-action="rollFormula">
          <b>{{item.system.label2}}:{{item.system.checkbase2}}({{item.system.checkbasefix2}})</b>
        </div>
          <div class='item-checkmod item-prop input' style="flex: 0 0 40px; display: {{#if system.usedice2}}block{{else}}none{{/if}};"><input class="cm2-change" type="text" value="{{item.system.checkmod2}}" data-dtype="Number" data-item-field="checkmod2"/></div>
        <div class="rollable" style="flex: 0 0 auto; margin-left: 10px; display: {{#if system.usedice3}}block{{else}}none{{/if}};" data-roll="{{item.system.checkformula3}}+{{item.system.checkbase3}}" data-label="{{item.name}} ({{item.system.label3}})" data-pt="{{item.system.powertable}}" data-apply="{{system.applycheck3}}" data-checktype="{{system.checkTypesButton}}" {{resistAttributes type system.dice3.resist}} data-action="rollFormula">
          <b>{{item.system.label3}}:{{item.system.checkbase3}}({{item.system.checkbasefix3}})</b>
        </div>
          <div class='item-checkmod item-prop input' style="flex: 0 0 40px; display: {{#if system.usedice3}}block{{else}}none{{/if}};"><input class="cm3-change" type="text" value="{{item.system.checkmod3}}" data-dtype="Number" data-item-field="checkmod3"/></div>
        <div class="powerrollable" style="flex: 0 0 auto; margin-left: 10px; display: {{#if system.usepower}}block{{else}}none{{/if}};" data-roll="{{item.system.powerformula}}" data-label="{{item.name}} ({{item.system.labelmonpow}})" data-pt="{{item.system.powertable}}" data-apply="{{system.applypower}}" data-powertype="{{system.powerTypesButton}}" data-action="rollFormula" data-power="true">
          <b>{{item.system.labelmonpow}}:k{{item.system.power}}{{#if item.system.totalcvalue}}@{{item.system.totalcvalue}}{{/if}}{{#if item.system.powerbase}}+{{item.system.powerbase}}{{/if}}</b>
        </div>
          <div class='item-checkmod item-prop input' style="flex: 0 0 40px; display: {{#if system.usepower}}block{{else}}none{{/if}};"><input class="pm-change" type="text" value="{{item.system.powermod}}" data-dtype="Number" data-item-field="powermod"/></div>
        <div class="execitemmacro tooltip usemacro applybutton" style="display: {{#if item.flags.itemacro}}{{#if item.flags.itemacro.macro}}{{#if item.flags.itemacro.macro.command}}block{{else}}none{{/if}}{{else}}none{{/if}}{{else}}none{{/if}};" data-action="executeMacro">
            <i class="fa-solid fa-code"></i><span class="tooltip-top">{{localize "SW25.Item.MacroB"}}</span>
        </div>
        <div class="applyeffect tooltip useeffect applybutton" style="display: {{#if system.useeffect}}block{{else}}none{{/if}};" data-action="applyItemEffects">
            <i class="fa-solid fa-hand-sparkles"></i><span class="tooltip-top">{{localize "SW25.Item.EffectB"}}</span>
        </div>
        {{#if system.hpcost}}
        <div class='hpcost item-prop' style="flex: 0 0 {{#if system.maxhpcost}}80px{{else}}40px{{/if}};" data-cost="{{item.system.hpcost}}" data-max="{{item.system.maxhpcost}}" data-label="{{item.name}}" data-type="{{item.type}}" data-action="payItemCost" data-resource="hp">
          <b>HP:{{system.hpcost}}{{#if system.maxhpcost}} ({{system.maxhpcost}}){{/if}}</b>
        </div>
        {{/if}}
        {{#if system.mpcost}}
        <div class="mpcost item-prop" style="flex: 0 0 40px;" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}" data-action="payItemCost" data-resource="mp">
          <b>MP:{{system.mpcost}}</b>
        </div>
        {{/if}}
        <div style="flex: 0 0 auto; margin-left: 10px; display: {{#if system.remark}}block{{else}}none{{/if}};"><b>{{item.system.remark}}</b></div>
        {{#if ../isOwner}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.monsterability")}}' data-action="editItem">
              <i class='fas fa-edit'></i>
            </a>
            <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.monsterability")}}' data-action="deleteItem">
              <i class='fas fa-trash'></i>
            </a>
          </div>
        {{else}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.monsterability")}}' data-action="editItem">
              <i class='fa-solid fa-eye'></i>
            </a>
          </div>
        {{/if}}
      </div>
      <div class="item-description nogapmargin">
        <div class="flexrow">
          <div style="flex: 0 0 60px;"></div>
          <div style="font-size: 0.8em;">
            {{{item.descriptionHTML}}}
          </div>
          <div style="flex: 0 0 50px;"></div>
        </div>
      </div>
    </li>
  {{/each}}
</ol>

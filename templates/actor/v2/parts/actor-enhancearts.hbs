<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.enhancearts"}}</div>
    <div class='item-element' style="flex: 0 0 50px;">MP</div>
    <div class='item-element sidebar-hidden' style="flex: 0 0 100px;">{{localize "SW25.Time"}}</div>
    <div class='item-controls'>
      <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.enhancearts")}}' data-item-type='enhancearts' data-action="createItem">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type=''}}
      </a>
    </div>
  </li>
  {{#each enhancearts as |item id|}}
    <li class='item draggable' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action="rollFormula">
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          {{> "systems/sw25-lunachil-maintained/templates/helper/action-marks.hbs"}}
          <h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
        </div>
        {{> "systems/sw25-lunachil-maintained/templates/actor/v2/parts/actor-useitems.hbs" item=item}}
        <div class='mpcost item-prop flexrow flex-group-center' style="flex: 0 0 50px;" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}" data-action="payItemCost" data-resource="mp">
          {{system.mpcost}}
        </div>
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 0 0 100px;">
          {{system.time}} 
        </div>
        {{#if ../isOwner}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.enhancearts")}}' data-action="editItem">
              <i class='fas fa-edit'></i>
            </a>
            {{#if ../system.isEdit}}
              <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.enhancearts")}}' data-action="deleteItem">
                <i class='fas fa-trash'></i>
              </a>
            {{else}}
              <div class="item-equip">
                {{#if system.useequip}}
                <label class="equip-toggle">
                  <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
                </label>
                {{/if}}
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.View" type=(localize "TYPES.Item.enhancearts")}}' data-action="editItem">
              <i class='fa-solid fa-eye'></i>
            </a>
            <div class="item-equip">
              {{#if system.useequip}}
              <label class="equip-toggle">
                <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
              </label>
              {{/if}}
            </div>
          </div>
        {{/if}}
      </div>
      <div class="item-description nogapmargin">
        <div class="flexrow">
          <div style="flex: 0 0 60px;"></div>
          <div style="font-size: 0.8em;">
            {{{descriptionHTML}}}
          </div>
          <div style="flex: 0 0 50px;"></div>
        </div>
      </div>
    </li>
  {{/each}}
</ol>

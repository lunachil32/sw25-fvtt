<ol class='items-list'>
  {{#if otherfeaturershow}}
    <div class='item flexrow items-header'>
      <div class='item-name'>{{localize "TYPES.Item.otherfeature"}}</div>
    </div>
    <div class='item flexrow ability-resource'>
      <div class='resources'>
        <div class="ability-label">
          {{localize "SW25.Resource"}}
        </div>
        {{#each otherfeatureresources as |item id|}}
          <li class='item draggable' data-item-id='{{item._id}}'>
            <div class="item-prop flexrow flex-group-center">
              <h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
            </div>
            {{#if ../isOwner}}
              <div class='item-quantity item-prop flexrow flex-group-center' style="flex: 0 0 80px;">
                <a class="quantity-button" data-adjustment="decrease" data-property="item.system.quantity" data-action="adjustItemField" data-field="quantity">
                  <i class="fas fa-minus"></i>
                </a>
                <input class="qt-change" type="text" value="{{item.system.quantity}}" data-dtype="Number" data-item-field="quantity"/>
                <a class="quantity-button" data-adjustment="increase" data-property="item.system.quantity" data-action="adjustItemField" data-field="quantity">
                  <i class="fas fa-plus"></i>
                </a>
              </div>
              {{#if ../system.isEdit}}
              <div class='item-controls'>
                <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.resource")}}' data-action="editItem">
                  <i class='fas fa-edit'></i>
                </a>
                <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.resource")}}' data-action="deleteItem">
                  <i class='fas fa-trash'></i>
                </a>
              </div>
              {{/if}}
            {{else}}
              <div class='item-prop flexrow flex-group-center' style="flex: 0 0 80px;">
                <input class="qt-change" type="text" value="{{item.system.quantity}}" data-dtype="Number" data-item-field="quantity"/>
              </div>
            {{/if}}
          </li>
        {{/each}}
      </div>
    </div>
  {{/if}}
  <li class='item flexrow items-header'>
    <div class='item-name'>{{#if otherfeaturershow}}{{localize "SW25.Item.Name"}}{{else}}{{localize "TYPES.Item.otherfeature"}}{{/if}}</div>
    <div class='item-element' style="flex: 0 0 100px;">{{localize "SW25.Item.Otherfeature.Type"}}</div>
    <div class='item-controls'>
      <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.otherfeature")}}' data-item-type='otherfeature' data-action="createItem">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type=''}}
      </a>
    </div>
  </li>
  {{#each otherfeature as |item id|}}
    <li class='item draggable' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action="rollFormula">
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          {{> "systems/sw25-lunachil-maintained/templates/helper/action-marks.hbs"}}
          <h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
        </div>
        {{> "systems/sw25-lunachil-maintained/templates/actor/v2/parts/actor-useitems.hbs" item=item}}
        <div class='hpcost' style="flex: 0 0 {{#if system.maxhpcost}}80px{{else}}40px{{/if}}; display: {{#if system.basehpcost}}block{{else}}none{{/if}};" data-cost="{{item.system.hpcost}}" data-max="{{item.system.maxhpcost}}" data-label="{{item.name}}" data-type="{{item.type}}" data-action="payItemCost" data-resource="hp">
          <b>HP:{{system.hpcost}}{{#if system.maxhpcost}} ({{system.maxhpcost}}){{/if}}</b>
        </div>
        <div class="mpcost" style="flex: 0 0 40px; display: {{#if system.basempcost}}block{{else}}none{{/if}};" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}" data-action="payItemCost" data-resource="mp">
          <b>MP:{{system.mpcost}}</b>
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 100px;">
          {{system.type}} 
        </div>
        {{#if ../isOwner}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.otherfeature")}}' data-action="editItem">
              <i class='fas fa-edit'></i>
            </a>
            {{#if ../system.isEdit}}
              <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.otherfeature")}}' data-action="deleteItem">
                <i class='fas fa-trash'></i>
              </a>
            {{else}}
              <div class="item-equip">
                {{#if system.useequip}}
                <label class="equip-toggle">
                  <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
                </label>
                {{/if}}
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.View" type=(localize "TYPES.Item.otherfeature")}}' data-action="editItem">
              <i class='fa-solid fa-eye'></i>
            </a>
            <div class="item-equip">
              {{#if system.useequip}}
              <label class="equip-toggle">
                <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
              </label>
              {{/if}}
            </div>
          </div>
        {{/if}}
      </div>
      <div class="item-description nogapmargin">
        <div class="flexrow">
          <div style="flex: 0 0 60px;"></div>
          <div style="font-size: 0.8em;">
            {{{descriptionHTML}}}
          </div>
          <div style="flex: 0 0 50px;"></div>
        </div>
      </div>
    </li>
  {{/each}}
</ol>

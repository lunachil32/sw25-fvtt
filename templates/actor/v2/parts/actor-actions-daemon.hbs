<ol class='items-list'>
  <div class='item flexrow items-header'>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Item.Dice"}}</div>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Item.Action.ActionResult"}}</div>
    <div class='item-element' style="flex: 0 0 120px;">{{localize "SW25.Item.Action.Label"}}</div>
    <div class='item-name'>{{localize "TYPES.Item.action"}}</div>
    <div class='item-element' style="flex: 0 0 100px;">{{localize "SW25.Item.Action.Label"}}</div>
    <div class='item-element' style="flex: 0 0 60px; margin-right: 10px;">{{localize "SW25.Item.Action.ActionValue"}}</div>
  </div>
  <div class="item flexrow">
    <div class="roll-actiontable rollable" data-result="1" style="flex: 0 0 60px; font-size: 24px; text-align: center;" data-action="rollActionTable">
      <i class="fas fa-dice-one"></i>
    </div>
    <div class="item flexcol" style="align-items: normal;">
      <div class="item flexrow actiontable" data-area="d18">
        <div style="flex: 0 0 60px; font-size: 16px; font-weight: bold; text-align: center;">8</div>
        <div class="item flexcol" style="align-items: normal;">
          {{#each actionsd18 as |item id|}}
          <li class='item action draggable' data-item-id='{{item._id}}'>
            <div class="flexrow flex-group-center">
              <div class='item-name' style="flex: 0 0 120px;">
                <div class='item-image'>
                  <a class='rollable' data-roll-type='item' data-action="rollFormula">
                    <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
                  </a>
                </div>
                <h4 class="action-label" data-action="toggleDetails" data-detail="action">{{item.name}}</h4>
              </div>
              <div class='item-name action-label item-prop' data-action="toggleDetails" data-detail="action">{{#if system.displayaction}}{{{system.displayaction}}}{{else}}{{system.action}}{{/if}}</div>
              {{> "systems/sw25-lunachil-maintained/templates/actor/v2/parts/actor-useitems.hbs" item=item}}
              <div class="mpcost" style="flex: 0 0 40px; display: {{#if system.mpcost}}block{{else}}none{{/if}};" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}" data-action="payItemCost" data-resource="mp">
                <b>{{localize "SW25.Item.MPB"}}</b>
              </div>
              <div class='item-prop flexrow flex-group-center' style="flex: 0 0 100px;">{{system.target}}</div>
              <div class='rollable item-prop flexrow flex-group-center' style="flex: 0 0 60px;" data-roll="{{item.system.checkformula1}}+{{item.system.checkbase1}}" data-label="{{item.name}} ({{localize "SW25.Item.Action.ActionValue"}})" data-pt="{{item.system.powertable}}" data-apply="{{system.applycheck1}}" data-checktype="{{system.checkTypesButton1}}" {{resistAttributes type system.dice1.resist}} data-action="rollFormula">
                {{system.actionvalue}} ({{system.actionresult}})
              </div>
            </div>
            <div class="action-description nogapmargin">
              <div class="flexrow">
                <div style="flex: 0 0 60px;"></div>
                <div class="flexcol textalign-left" style="font-size: 0.8em;">
                  {{#if system.dialog}}<span><b>{{localize "SW25.Item.Action.Dialog"}}:</b> {{system.dialog}}</span>{{/if}}
                  {{#if system.displayactioneffect}}
                  <span><b>{{localize "SW25.Item.Action.ActionEffect"}}:</b></span>
                  <span>{{#if system.displayactioneffect}}{{{system.displayactioneffect}}}{{else}}{{system.actioneffect}}{{/if}}</span>
                  {{/if}}
                  {{#if system.description}}
                  <span><b>{{localize "SW25.Description"}}:</b></span>
                  <span>{{{descriptionHTML}}}</span>
                  {{/if}}
                </div>
                <div class='item-controls' style="flex: 0 0 50px;">
                  <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.action")}}' data-action="editItem">
                    <i class='fas fa-edit'></i>
                  </a>
                  <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.action")}}' data-action="deleteItem">
                    <i class='fas fa-trash'></i>
                  </a>
                </div>
              </div>
            </div>
          </li>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

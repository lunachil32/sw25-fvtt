<ol class='items-list'>
  {{#if lifelineshow}}
    <div class='item flexrow items-header'>
      <div class='item-name'>{{localize "TYPES.Item.phasearea"}}</div>
    </div>
    <div class='item flexrow ability-resource'>
      <div class='resources'>
        <div class="ability-label">
          <div class="lifelinereset left-position" data-tooltip="{{localize "SW25.Reset" type=(localize "SW25.Item.Resource.Types.Lifeline")}}" data-action="resetResources" data-resource-type="lifeline"><i class="fa-solid fa-arrow-rotate-left"></i></div>
          {{localize "SW25.Item.Phasearea.Lifeline"}}
          <div class="lifelineadd right-position" data-tooltip="{{localize "SW25.Add" type=(localize "SW25.Item.Resource.Types.Lifeline")}}" data-action="gainLifeline"><i class="fa-solid fa-arrow-rotate-right"></i></div>
        </div>
        {{#each lifelines as |item id|}}
          <li class='item draggable' data-item-id='{{item._id}}'>
            <div>
              <div class="item-prop flexrow flex-group-center">
                <h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
              </div>
              {{#if ../isOwner}}
                <div class='item-quantity item-prop flexrow flex-group-center' style="flex: 0 0 80px;">
                  <a class="quantity-button" data-adjustment="decrease" data-property="item.system.quantity" data-action="adjustItemField" data-field="quantity">
                    <i class="fas fa-minus"></i>
                  </a>
                  <input class="qt-change" type="text" value="{{item.system.quantity}}" data-dtype="Number" data-item-field="quantity"/>
                  / {{item.system.qmax}}
                  <a class="quantity-button" data-adjustment="increase" data-property="item.system.quantity" data-action="adjustItemField" data-field="quantity">
                    <i class="fas fa-plus"></i>
                  </a>
                </div>
                {{#if ../system.isEdit}}
                <div class='item-controls'>
                  <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.resource")}}' data-action="editItem">
                    <i class='fas fa-edit'></i>
                  </a>
                  <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.resource")}}' data-action="deleteItem">
                    <i class='fas fa-trash'></i>
                  </a>
                </div>
                {{/if}}
              {{else}}
                <div class='item-prop flexrow flex-group-center' style="flex: 0 0 80px;">
                  <input class="qt-change" type="text" value="{{item.system.quantity}}" data-dtype="Number" data-item-field="quantity"/>
                  / {{item.system.qmax}}
                </div>
              {{/if}}
            </div>
          </li>
        {{/each}}
      </div>
    </div>
  {{/if}}
  <li class='item flexrow items-header'>
    <div class='item-name'>{{#if lifelineshow}}{{localize "SW25.Item.Name"}}{{else}}{{localize "TYPES.Item.phasearea"}}{{/if}}</div>
    <div class='item-element' style="flex: 0 0 70px;">{{localize "SW25.Cost"}}</div>
    <div class='item-element sidebar-hidden' style="flex: 0 0 100px;">{{localize "SW25.Time"}}</div>
    <div class='item-element sidebar-hidden' style="flex: 0 0 80px;">{{localize "SW25.Item.Prop"}}</div>
    <div class='item-controls'>
      <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.phasearea")}}' data-item-type='phasearea' data-action="createItem">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type=''}}
      </a>
    </div>
  </li>
  {{#each phaseareas as |item id|}}
    <li class='item draggable' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item' data-action="rollFormula">
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          {{> "systems/sw25-lunachil-maintained/templates/helper/action-marks.hbs"}}
          <{{system.typename}}{{localize "SW25.Item.Phasearea.Phase"}}><h4 class="item-label" data-action="toggleDetails" data-detail="item">{{item.name}}</h4>
        </div>
        <div class="usephasearea tooltip applybutton" style="display: block;" data-action="usePhasearea">
          <i class="fa-solid fa-wand-magic-sparkles"></i><span class="tooltip-top">{{localize "SW25.Use"}}</span>
        </div>
        {{> "systems/sw25-lunachil-maintained/templates/actor/v2/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 70px;">
          {{system.typename}} : {{system.mincost}}{{#unless (eq system.maxcost 0)}} - {{system.maxcost}}{{/unless}}
        </div>
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 0 0 100px;">
          {{system.time}} 
        </div>
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 0 0 80px;">
          {{system.propname}}
        </div>
        {{#if ../isOwner}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.phasearea")}}' data-action="editItem">
              <i class='fas fa-edit'></i>
            </a>
            {{#if ../system.isEdit}}
              <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.phasearea")}}' data-action="deleteItem">
                <i class='fas fa-trash'></i>
              </a>
            {{else}}
              <div class="item-equip">
                {{#if system.useequip}}
                <label class="equip-toggle">
                  <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
                </label>
                {{/if}}
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.View" type=(localize "TYPES.Item.phasearea")}}' data-action="editItem">
              <i class='fa-solid fa-eye'></i>
            </a>
            <div class="item-equip">
              {{#if system.useequip}}
              <label class="equip-toggle">
                <input class="eq-change" type="checkbox" data-dtype="Boolean" {{#if system.equip}} checked {{/if}} data-item-field="equip"/>
              </label>
              {{/if}}
            </div>
          </div>
        {{/if}}
      </div>
      <div class="item-description nogapmargin">
        <div class="flexrow">
          <div style="flex: 0 0 60px;"></div>
          <div style="font-size: 0.8em;">
            {{{descriptionHTML}}}
          </div>
          <div style="flex: 0 0 50px;"></div>
        </div>
      </div>
    </li>
  {{/each}}
</ol>

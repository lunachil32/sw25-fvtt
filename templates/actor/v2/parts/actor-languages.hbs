<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.language"}}</div>
    <div class='item-element' style="flex: 0 0 30px;">{{localize "SW25.Item.Language.Conversation"}}</div>
    <div class='item-element' style="flex: 0 0 30px;">{{localize "SW25.Item.Language.Reading"}}</div>
    <div class='item-controls' style="flex: 0 0 60px;">
      <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.language")}}' data-item-type='language' data-action="createItem">
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type=''}}
      </a>
    </div>
  </li>
  {{#each languages as |item id|}}
    <li class='item draggable' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class='item-name' style="flex: 3;"><h4>{{item.name}}</h4></div>
        <div class="flex-group-center" style="flex: 0 0 30px;">
          <input class="cv-change" type="checkbox" data-dtype="Boolean" {{#if system.conversation}} checked {{/if}}{{#unless ../system.isEdit}} disabled{{/unless}} data-item-field="conversation"/>
        </div>
        <div class="flex-group-center" style="flex: 0 0 30px;">
          <input class="rd-change" type="checkbox" data-dtype="Boolean" {{#if system.reading}} checked {{/if}}{{#unless ../system.isEdit}} disabled{{/unless}} data-item-field="reading"/>
        </div>
        {{#if ../isOwner}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.language")}}' data-action="editItem">
              <i class='fas fa-edit'></i>
            </a>
            {{#if ../system.isEdit}}
            <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.language")}}' data-action="deleteItem">
              <i class='fas fa-trash'></i>
            </a>
            {{/if}}
          </div>
        {{else}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.language")}}' data-action="editItem">
              <i class='fa-solid fa-eye'></i>
            </a>
          </div>
        {{/if}}
      </div>
    </li>
  {{/each}}
</ol>
